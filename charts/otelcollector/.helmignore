# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.helmignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# CI / CD file
.github/
.circleci/
.travis.yml
Jenkinsfile
# Documentation
README.md
CHANGELOG.md
CONTRIBUTING.md
LICENSE
docs/
# CI tests and values
ci/
